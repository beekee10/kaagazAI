# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Gemini AI Models (Future-proof configuration)
# GEMINI_MODEL: Main LLM for answering questions (e.g., gemini-flash-latest, gemini-2.5-flash, gemini-pro-latest)
# Using 'gemini-flash-latest' automatically routes to Google's latest stable Flash model
GEMINI_MODEL=gemini-flash-latest

# GEMINI_EMBEDDING_MODEL: Embedding model for vector representations (default: models/gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Directory to store uploaded PDFs locally
UPLOAD_DIR=./uploads

# Directory where ChromaDB stores its vector database files
CHROMA_DB_DIR=./chroma_db

# Document chunking settings
# chunk_size: number of characters per chunk
# chunk_overlap: number of characters repeated across chunks to preserve context at boundaries
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Number of top relevant document chunks retrieved for answering
TOP_K=4
